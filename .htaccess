RewriteEngine on
<IfModule mod_dtimeout.c>
  <Files index.php>
      SetEnvIf Query_String "index.php" DynamicTimeout=300
  </Files>
</IfModule>

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond $1 !^(index\.php|images|img|css|js|robots\.txt)
RewriteCond $1 !^(index\.php|application/views/|robots\.txt|install|favicon\.ico|documents)
RewriteRule ^(.+)$ index.php?$1 [L]

# Use XAMPP's configured PHP handler locally. The live server used PHP 5.6.
# AddHandler application/x-httpd-php56 .php .php5 .php4 .php3
